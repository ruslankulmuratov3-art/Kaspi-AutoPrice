# Local: copy to .env. Render: add these in Environment Variables.
PYTHON_VERSION=3.13.7
ENVIRONMENT=local
DEBUG=false
DATABASE_URL=sqlite:///./kaspi_saas.db
PUBLIC_BASE_URL=
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

# Official Kaspi API: schema/import/status and orders.
KASPI_BASE_URL=https://kaspi.kz/shop/api
KASPI_API_TOKEN=
KASPI_MERCHANT_ID=30140513
KASPI_STORE_ID=30140513
KASPI_COMPANY_NAME=EXCLUSIVE_KZ
KASPI_DEFAULT_BRAND=NoBrand
KASPI_HTTP_TIMEOUT_SECONDS=30

# Direct price API remains disabled unless Kaspi gives a documented endpoint.
KASPI_DIRECT_PRICE_API_ENABLED=false
KASPI_DIRECT_PRICE_UPDATE_PATH=
KASPI_DIRECT_PRICE_UPDATE_METHOD=POST
KASPI_PRICE_UPDATE_FORMAT=xml_catalog

# Public competitor source. No CAPTCHA bypass, cookies or browser automation.
KASPI_PUBLIC_OFFERS_ENABLED=true
KASPI_PUBLIC_OFFERS_BASE_URL=https://kaspi.kz/yml/offer-view/offers
KASPI_PUBLIC_OFFERS_METHOD=POST
KASPI_PUBLIC_CITY_ID=750000000
KASPI_PUBLIC_OFFERS_LIMIT=10
KASPI_PUBLIC_SORT_OPTION=PRICE
KASPI_PUBLIC_OFFERS_REQUESTS_PER_MINUTE=6
KASPI_PUBLIC_OFFERS_FAILURE_THRESHOLD=2
KASPI_PUBLIC_OFFERS_COOLDOWN_MINUTES=60
KASPI_PUBLIC_OFFERS_MAX_COOLDOWN_MINUTES=720
KASPI_PUBLIC_OFFERS_BACKOFF_BASE_SECONDS=2
KASPI_PUBLIC_OFFERS_BACKOFF_MAX_SECONDS=30
KASPI_PUBLIC_OFFERS_JITTER_SECONDS=1.5

# Cache and safe fallback.
KASPI_COMPETITOR_CACHE_MINUTES=360
KASPI_COMPETITOR_STALE_CACHE_MINUTES=4320
KASPI_USE_STALE_COMPETITOR_CACHE_ON_ERROR=true

# Persistent autopilot worker.
KASPI_AUTOPILOT_ENABLED=true
KASPI_AUTOPILOT_INTERVAL_MINUTES=30
KASPI_AUTOPILOT_STARTUP_DELAY_SECONDS=25
KASPI_AUTOPILOT_MAX_PRODUCTS_PER_RUN=5000
KASPI_AUTOPILOT_BATCH_SIZE=25
KASPI_AUTOPILOT_WAREHOUSE_ID=PP1
KASPI_AUTOPILOT_UPDATE_LOCAL_PRICE=true
KASPI_AUTOPILOT_CONCURRENCY=1
KASPI_AUTOPILOT_DELAY_SECONDS=5
KASPI_AUTOPILOT_ONLY_IN_STOCK=true
KASPI_AUTOPILOT_HEARTBEAT_TIMEOUT_MINUTES=15
KASPI_AUTOPILOT_POLL_SECONDS=3

# Kaspi XML requests must return immediately and never start a full calculation.
KASPI_XML_REBUILD_ON_PULL=false
KASPI_XML_MIN_PRODUCT_RATIO=0.95
KASPI_XML_MAX_DROP_RATIO=0.10
KASPI_XML_KEEP_VERSIONS=100

# Configurable safety budget. Keep disabled if your Kaspi agreement says otherwise.
KASPI_PRICE_CHANGE_LIMIT_ENABLED=true
KASPI_PRICE_CHANGE_WINDOW_MINUTES=30
KASPI_PRICE_CHANGE_LIMIT_PER_WINDOW=250
KASPI_PRICE_CHANGE_SAFETY_RESERVE=10
