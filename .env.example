APP_NAME=Kaspi Price Manager Real
APP_VERSION=2.1.0-real-api
ENVIRONMENT=production
DEBUG=true
ENABLE_DOCS=true
SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Локально можно SQLite. На VPS лучше PostgreSQL.
DATABASE_URL=sqlite:///./kaspi_saas.db
# DATABASE_URL=postgresql+psycopg://kaspi:kaspi@db:5432/kaspi_saas
AUTO_CREATE_TABLES=true

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Реальный Kaspi API. Токен сюда вставляешь сам, мне его отправлять НЕ надо.
KASPI_BASE_URL=https://kaspi.kz/shop/api
KASPI_API_TOKEN=
KASPI_MERCHANT_ID=
KASPI_STORE_ID=
KASPI_COMPANY_NAME=
KASPI_DEFAULT_BRAND=NoBrand
KASPI_HTTP_TIMEOUT_SECONDS=30

# Официальные product-import endpoints Kaspi.
KASPI_IMPORT_SCHEMA_PATH=/products/import/schema
KASPI_PRODUCTS_IMPORT_PATH=/products/import
KASPI_IMPORT_STATUS_PATH=/products/import
KASPI_IMPORT_RESULT_PATH=/products/import/result

# Формат отправки цены: json_import или xml_catalog.
# Начни с json_import. Если твой кабинет принимает XML прайс-лист, поставь xml_catalog.
KASPI_PRICE_UPDATE_FORMAT=json_import

# Endpoint офферов конкурентов. Если в твоём партнёрском API его нет — оставь пустым.
# Пример формата, если Kaspi/партнер выдал такой метод: https://example.kz/products/{sku}/offers
KASPI_PUBLIC_OFFERS_ENABLED=true
KASPI_PUBLIC_OFFERS_BASE_URL=https://kaspi.kz/yml/offer-view/offers
KASPI_PUBLIC_CITY_ID=750000000
KASPI_PUBLIC_OFFERS_LIMIT=30
KASPI_PUBLIC_SORT_OPTION=PRICE
KASPI_OFFERS_URL_TEMPLATE=

PRICE_CHECK_INTERVAL_MINUTES=15
MAX_PRICE_CHANGE_PERCENT=30
DEFAULT_CURRENCY=KZT

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
