# Never commit real tokens. Put real values into Render Environment Variables.
PYTHON_VERSION=3.13.7
DATABASE_URL=
SECRET_KEY=change-this-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

KASPI_API_TOKEN=your_token_here
KASPI_MERCHANT_ID=30140513
KASPI_STORE_ID=30140513
KASPI_COMPANY_NAME=EXCLUSIVE_KZ
KASPI_DEFAULT_BRAND=NoBrand

# Public competitor monitoring. This is not the Seller API.
KASPI_PUBLIC_OFFERS_ENABLED=true
KASPI_PUBLIC_CITY_ID=750000000
KASPI_PUBLIC_OFFERS_LIMIT=10
KASPI_PUBLIC_SORT_OPTION=PRICE
KASPI_AUTOPILOT_CONCURRENCY=1
KASPI_AUTOPILOT_DELAY_SECONDS=5
KASPI_COMPETITOR_CACHE_MINUTES=360
KASPI_USE_STALE_COMPETITOR_CACHE_ON_ERROR=true

# XML autopilot
KASPI_AUTOPILOT_ENABLED=true
KASPI_AUTOPILOT_INTERVAL_MINUTES=30
KASPI_AUTOPILOT_STARTUP_DELAY_SECONDS=25
KASPI_AUTOPILOT_MAX_PRODUCTS_PER_RUN=5000
KASPI_AUTOPILOT_WAREHOUSE_ID=PP1
KASPI_AUTOPILOT_UPDATE_LOCAL_PRICE=true
KASPI_XML_REBUILD_ON_PULL=true
KASPI_XML_STALE_AFTER_MINUTES=25
KASPI_AUTOPILOT_ONLY_IN_STOCK=true

# Price-change safety window
KASPI_PRICE_CHANGE_LIMIT_ENABLED=true
KASPI_PRICE_CHANGE_WINDOW_MINUTES=30
KASPI_PRICE_CHANGE_LIMIT_PER_WINDOW=250
KASPI_PRICE_CHANGE_SAFETY_RESERVE=10

# Official pricing modes
KASPI_DIRECT_PRICE_API_ENABLED=false
KASPI_DIRECT_PRICE_UPDATE_PATH=
KASPI_DIRECT_PRICE_UPDATE_METHOD=POST
KASPI_PRICE_UPDATE_FORMAT=xml_catalog
